{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "english-island-api",
  "main": "index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 19 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-island-results",
      "database_id": "87103fb7-ffae-4214-9b80-bef003bfc7e9",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGINS": "https://english-adventure-island-5om.pages.dev",
    "ACCESS_TEAM_DOMAIN": "REPLACE.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUDIENCE",
    "TEACHER_EMAILS": "g9641723@gmail.com",
  },
}
